<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/keepScreenOnSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="48dp"
            android:text="@string/viewer_settings_keep_screen_on"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/systemBrightnessSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/viewer_settings_system_brightness"
            android:textSize="16sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/brightnessSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:valueTo="1.0" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/ttsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/viewer_settings_tts"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/instantInteractionsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="48dp"
            android:text="@string/viewer_settings_instant_interactions"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/doubleTapPageNavSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="48dp"
            android:text="@string/viewer_settings_double_tap_page_nav"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/bubbleScaleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/viewer_settings_bubble_scale"
            android:textSize="16sp"
            tools:text="Bubble size: 100%" />

        <com.google.android.material.slider.Slider
            android:id="@+id/bubbleScaleSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/viewer_settings_bubble_scale"
            android:minHeight="48dp"
            android:stepSize="0.1"
            android:valueFrom="1.0"
            android:valueTo="4.0" />

        <TextView
            android:id="@+id/maxZoomLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/viewer_settings_max_zoom"
            android:textSize="16sp"
            tools:text="Maximum zoom: 2×" />

        <com.google.android.material.slider.Slider
            android:id="@+id/maxZoomSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/viewer_settings_max_zoom"
            android:minHeight="48dp"
            android:stepSize="1.0"
            android:valueFrom="1.0"
            android:valueTo="10.0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/viewer_settings_gestures_section"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/viewer_settings_gesture_bottom_swipe_up"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/bottomSwipeUpActionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/viewer_settings_gesture_two_finger_bottom"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/twoFingerTapBottomActionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/viewer_settings_gesture_two_finger_top"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/twoFingerTapTopActionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.core.widget.NestedScrollView>